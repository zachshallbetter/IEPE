{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepe.dev/schema/agent-package-source.schema.json",
  "title": "IEPE Agent Project Package Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageId", "packageVersion", "projectRoot", "protocol", "releaseClass", "sourceState", "operatingContract", "sources", "skills", "adapters", "exclusions"],
  "properties": {
    "$schema": {"type": "string"},
    "manifestSchema": {"type": "string"},
    "packageId": {"type": "string", "minLength": 1},
    "packageVersion": {"type": "string", "minLength": 1},
    "projectRoot": {"type": "string", "minLength": 1},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolId", "protocolVersion", "source", "revision"],
      "properties": {
        "protocolId": {"const": "IEPE-001"},
        "protocolVersion": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 7}
      }
    },
    "releaseClass": {"enum": ["provisional", "release"]},
    "sourceState": {"enum": ["clean", "dirty", "unknown", "provisional"]},
    "operatingContract": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "authorityRank"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["intent", "doctrine", "ontology", "schema", "implementation", "operations", "evidence", "historical"]},
          "authorityRank": {"type": "integer", "minimum": 1}
        }
      }
    },
    "skills": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "adapters": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "exclusions": {"type": "array", "items": {"type": "string"}}
  }
}
