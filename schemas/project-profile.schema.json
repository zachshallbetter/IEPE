{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepe.dev/schema/project-profile.schema.json",
  "title": "IEPE Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "protocol", "intentRefs", "authorityOrder", "workGraph", "coordinator", "evaluators", "protectedActions", "promotionAuthorities", "memory"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolId", "protocolVersion", "source", "revision"],
      "properties": {
        "protocolId": {"const": "IEPE-001"},
        "protocolVersion": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 7}
      }
    },
    "intentRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "authorityOrder": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "workGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "projectRefs"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "projectRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "workspaces": { "type": "array", "items": { "type": "string" }, "default": [] },
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "capacity"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "capacity": { "type": "integer", "minimum": 1 },
        "stopPolicyRef": { "type": ["string", "null"] }
      }
    },
    "evaluators": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "protectedActions": { "type": "array", "items": { "type": "string" } },
    "promotionAuthorities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operational", "institutional", "negativeResults"],
      "properties": {
        "operational": { "type": "string", "minLength": 1 },
        "institutional": { "type": "string", "minLength": 1 },
        "negativeResults": { "type": "string", "minLength": 1 }
      }
    }
  }
}
