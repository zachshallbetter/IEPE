{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepe.dev/schema/issue-contract.schema.json",
  "title": "IEPE Issue Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "intentRefs",
    "objective",
    "owner",
    "acceptanceCriteria",
    "evidenceRequired",
    "constraints",
    "permissions",
    "stopConditions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "delivery",
        "experiment",
        "candidate",
        "evaluation",
        "design",
        "decision",
        "documentation",
        "incident",
        "promotion",
        "observation"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "intentRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "experienceRefs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "objective": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": ["string", "null"] },
    "owner": { "type": "string", "minLength": 1 },
    "workspace": { "type": ["string", "null"] },
    "parent": { "type": ["string", "null"] },
    "dependencies": { "type": "array", "items": { "type": "string" }, "default": [] },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidenceRequired": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "exclusions": { "type": "array", "items": { "type": "string" }, "default": [] },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalWrites", "deployments", "communications", "spending"],
      "properties": {
        "externalWrites": { "type": "boolean" },
        "deployments": { "type": "boolean" },
        "communications": { "type": "boolean" },
        "spending": { "type": "boolean" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": { "type": ["string", "null"] },
        "cost": { "type": ["number", "null"], "minimum": 0 },
        "iterations": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "stopConditions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
