{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepe.dev/schema/evidence-bundle.schema.json",
  "title": "IEPE Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "issueId",
    "artifactRefs",
    "intentRefs",
    "environment",
    "evaluations",
    "limitations",
    "qualification"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "issueId": { "type": "string", "minLength": 1 },
    "candidateId": { "type": ["string", "null"] },
    "artifactRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "intentRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "authorityRefs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "environment": { "type": "object" },
    "inputs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "provenance": { "type": "array", "items": { "type": "string" }, "default": [] },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension", "result", "evaluator"],
        "properties": {
          "dimension": { "type": "string" },
          "result": {},
          "evaluator": { "type": "string" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "baselineComparison": { "type": ["object", "null"] },
    "cost": { "type": ["object", "null"] },
    "tradeoffs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "qualification": {
      "enum": ["documented", "implemented", "tested", "empirically-validated"]
    },
    "promotionRecommendation": {
      "enum": ["reject", "retain", "retry", "revise", "escalate", "promote", null]
    },
    "reproduction": { "type": ["string", "null"] }
  }
}
