{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepe.dev/schema/experience-contract.schema.json",
  "title": "IEPE Experience Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "intent", "audience", "desiredOutcomes", "experientialQualities", "states", "constraints", "accessibilityRequirements", "evidenceRequirements"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "contexts"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "contexts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "desiredOutcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "experientialQualities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "behaviorsToEncourage": { "type": "array", "items": { "type": "string" }, "default": [] },
    "behaviorsToAvoid": { "type": "array", "items": { "type": "string" }, "default": [] },
    "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "accessibilityRequirements": { "type": "array", "items": { "type": "string" } },
    "evidenceRequirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "authorityRefs": { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}
