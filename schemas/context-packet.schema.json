{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepe.dev/schema/context-packet.schema.json",
  "title": "IEPE Bounded Context Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "issueId", "claimId", "objective", "sources", "dependencies", "constraints", "evidenceRequired", "permissions", "stopConditions", "contextSha256"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "minLength": 1},
    "issueId": {"type": "string", "minLength": 1},
    "claimId": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind", "authorityRank", "sha256"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "kind": {"enum": ["intent", "authority", "experience", "dependency", "evidence", "operations"]},
          "authorityRank": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "dependencies": {"type": "object", "additionalProperties": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "evidenceRequired": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "permissions": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "stopConditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "contextSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
