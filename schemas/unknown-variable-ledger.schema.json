{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepe.dev/schema/unknown-variable-ledger.schema.json",
  "title": "IEPE Unknown Variable Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "projectRef", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "projectRef": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "variable", "classification", "evidenceRefs", "nextProbe"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "variable": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["known-controlled", "known-unresolved", "assumed-untested", "observed-once", "discovered-through-perturbation", "currently-unknowable"] },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } },
          "nextProbe": { "type": ["string", "null"] }
        }
      }
    }
  }
}
