{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepe.dev/schema/promotion-record.schema.json",
  "title": "IEPE Promotion Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subjectRef", "issueRef", "evidenceBundleRef", "authority", "decision", "target", "tradeoffs", "recoveryPlan"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "subjectRef": { "type": "string", "minLength": 1 },
    "issueRef": { "type": "string", "minLength": 1 },
    "evidenceBundleRef": { "type": "string", "minLength": 1 },
    "authority": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["approved", "rejected", "deferred", "revoked"] },
    "target": { "type": "string", "minLength": 1 },
    "tradeoffs": { "type": "array", "items": { "type": "string" } },
    "conditions": { "type": "array", "items": { "type": "string" }, "default": [] },
    "recoveryPlan": { "type": "string", "minLength": 1 },
    "effectiveAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
